# Single public entrypoint for the whole stack: serves the built SPA and
# reverse-proxies everything Django-owned to the backend service, so the
# browser only ever sees one origin (see ARCHITECTURE.md "Why a
# reverse-proxy-fronted stack" -- this is what makes plain session-cookie
# auth work with no CORS/JWT plumbing).
#
# This file is a *template*: the base image's docker-entrypoint.d runs
# envsubst over every /etc/nginx/templates/*.template file at container
# start, substituting only variables that actually exist in the container's
# environment -- ${NGINX_LOCAL_RESOLVERS} is auto-detected at startup (see
# Dockerfile's NGINX_ENTRYPOINT_LOCAL_RESOLVERS), ${BACKEND_SERVICE_HOST}/
# ${BACKEND_SERVICE_PORT} default to docker-compose.yml's own service
# name/port (see Dockerfile), overridable as plain container env vars with
# no rebuild -- e.g. in Kubernetes, to match your backend Service's actual
# name/namespace/port. Every other $-prefixed token below (e.g. $scheme,
# $host, $remote_addr) is an nginx runtime variable, not a container env
# var, so envsubst leaves it untouched.

# Preserves an already-correct X-Forwarded-Proto from an upstream proxy
# (e.g. a TLS-terminating Kubernetes Ingress in front of this container) --
# falls back to this container's own $scheme (e.g. plain "http" under
# docker-compose, which has no TLS-terminating hop in front of it).
# Without this, a value set by an outer proxy would get silently
# overwritten below with whatever scheme *this* hop saw, which is wrong
# whenever TLS terminates upstream of this container instead of here.
map $http_x_forwarded_proto $proxy_x_forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server {
    # Unprivileged port -- this image runs as a non-root user (see
    # Dockerfile), which can't bind port 80.
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri /index.html;
    }

    location ~ ^/(api|accounts|admin|invite|static|media)/ {
        # Re-resolve the backend host through DNS on every request (via the
        # $backend variable) instead of once at nginx startup -- otherwise,
        # whenever the backend container/pod gets recreated, its IP changes
        # and nginx keeps proxying to the old, now-dead address until nginx
        # itself is restarted. ${NGINX_LOCAL_RESOLVERS} is auto-detected
        # from /etc/resolv.conf at container start (see Dockerfile) --
        # Docker's embedded DNS under docker-compose, your cluster's
        # CoreDNS/kube-dns under Kubernetes, no manual configuration needed
        # either way.
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
        set $backend "${BACKEND_SERVICE_HOST}:${BACKEND_SERVICE_PORT}";
        proxy_pass http://$backend;
        # $host drops the port from the incoming Host header (that's how
        # nginx defines it), so when this stack is reached through a
        # non-default port, Django loses track of it too -- allauth then
        # builds absolute URLs (like the OIDC callback redirect_uri)
        # against a portless host, which breaks the round trip back from
        # the IdP. $http_host passes the original Host header through
        # untouched, port included.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;

        # nginx's own default (1m) is well below what a real POST /api/jobs/
        # needs: r2v takes up to 9 reference images + 3 reference audio
        # clips in one multipart request (see generation/api.py). Hit this
        # for real as a 413 rejected by nginx itself, before the request
        # ever reached Django -- Django's own DATA_UPLOAD_MAX_MEMORY_SIZE
        # doesn't apply here (it explicitly excludes file upload data), so
        # this was the only thing actually capping it.
        client_max_body_size 500m;

        # nginx's own default (60s) is below integrations/llm.py's own 120s
        # request timeout for AI-refine/chat -- without this, nginx would
        # give up on a slow LLM reply and return a 504 before Django (and
        # gunicorn, see backend/Dockerfile's --timeout) ever got the chance
        # to. Matches gunicorn's --timeout 180 so neither layer is the
        # limiting factor ahead of the LLM call's own intentional timeout.
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }
}
