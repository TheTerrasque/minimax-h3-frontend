# Copy to .env and fill in. Consumed by docker-compose.yml via env_file: for
# every backend-image-based service (backend, qcluster, migrate).

# --- Postgres (the `db` service) ---
POSTGRES_DB=mm_h3
POSTGRES_USER=mm_h3
POSTGRES_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# --- Django core ---
# Generate one, e.g.: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Must include every origin you actually load the SPA from (nginx's
# published port -- see docker-compose.yml's `frontend` service, default
# 8080) -- comma-separated if more than one. Django checks the browser's
# Origin header against this list exactly, so "localhost:8080" here does NOT
# also cover "127.0.0.1:8080" (or any other hostname/IP that resolves to the
# same machine) -- browsing via an origin missing from this list 403s with
# "CSRF verification failed" on every POST, including login.
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# All three default to false so plain HTTP (e.g. this docker-compose stack
# with no TLS in front of it) still works out of the box. Set all three to
# true once this is actually served over HTTPS (e.g. behind a Kubernetes
# Ingress with a real cert).
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
# Seconds browsers should refuse plain HTTP for this host after seeing one
# HTTPS response (HSTS). 0 = off. Only set this once every subdomain you'd
# ever serve here is HTTPS-only too -- it's a browser-cached promise that's
# hard to walk back early. Leave at 0 until DJANGO_SECURE_SSL_REDIRECT=true
# has been running fine for a while.
DJANGO_SECURE_HSTS_SECONDS=0

# --- ComfyUI (see resources/COMFYUI_API_GUIDE.md) ---
# This 8000 is the HOST's ComfyUI Desktop app, unrelated to the backend
# container's own internal port 8000 -- different network namespaces, just a
# coincidentally shared default. host.docker.internal reaches the host from
# inside a container (works out of the box on Docker Desktop; on Linux
# Docker, docker-compose.yml already adds the extra_hosts entry that makes
# it resolve too).
#
# If ComfyUI runs on another machine on your LAN instead, a plain hostname
# (mDNS/NetBIOS, e.g. "mymachine" or "mymachine.local") that resolves fine
# from this host may NOT resolve from inside the container -- Docker's
# embedded DNS doesn't do that resolution, even though your own machine's
# OS does (hit this for real: gpusun/gpusun.lan resolved from Windows via
# nslookup but the container got NameResolutionError on the exact same
# name). Use the machine's IP address directly if you hit this, or add an
# extra_hosts entry to the affected services in docker-compose.yml.
COMFYUI_BASE_URL=http://host.docker.internal:8000
# Absolute path to ComfyUI's output/ folder, mounted/reachable from this
# machine -- used to delete files after downloading them (see
# resources/COMFYUI_API_GUIDE.md #10). Leave blank to skip that cleanup step.
COMFYUI_OUTPUT_ROOT=

# --- LLM prompt-assist (see integrations/llm.py) ---
# Any OpenAI-compatible /chat/completions endpoint. LLM_API_BASE_URL and
# LLM_MODEL are both required to enable the AI refine/chat features at all;
# LLM_API_KEY is optional -- leave it blank for self-hosted servers (llama.cpp
# server, LM Studio, text-generation-webui, vLLM in permissive mode, etc.)
# that don't require one. Restart/recreate the backend + qcluster containers
# after editing these -- env_file values are only read at container start.
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Off by default. Sends actual reference image bytes to the LLM (both the
# one-shot refine and chat) as vision content parts instead of just their
# <Picture N> labels -- only turn this on if LLM_MODEL is actually
# vision-capable; a text-only model may error or ignore them.
LLM_VISION_ENABLED=false

# --- Optional pre/post hooks (see integrations/hooks.py) ---
# Dotted Python paths to callables, e.g. hooks_example.wake_gpu_server (see
# backend/hooks_example.py for a starting template). All four are unset
# (no-op) by default. Each runs synchronously and swallows its own
# exceptions -- a broken hook is logged, never blocks the real LLM call or
# render.
PRE_LLM_HOOK=
POST_LLM_HOOK=
PRE_RENDER_HOOK=
POST_RENDER_HOOK=

# --- OIDC login (see accounts/adapters.py, django-allauth) ---
# Leave OIDC_CLIENT_ID blank to boot without OIDC configured yet.
OIDC_PROVIDER_NAME=OIDC
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# true: anyone who completes OIDC login gets an account, no invite needed
# (the configured IdP is itself the trust gate). false: require an invite
# for OIDC logins too, same as any other new signup.
OIDC_AUTO_SIGNUP=true

# --- Email (optional -- signup/password-reset confirmation emails) ---
# Leave EMAIL_HOST blank to print these emails to the container's logs
# instead of actually sending them -- fine for local/invite-only use where
# you don't need a real mail server. Set it to enable real SMTP delivery.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=webmaster@localhost

# --- Django-Q2 ---
# Keep at 1 -- jobs are processed strictly one at a time, FIFO (see
# generation/tasks.py's process_queue()); a higher worker count would let
# multiple jobs render in parallel, breaking that guarantee.
Q_CLUSTER_WORKERS=1
# Hard wall-clock kill of the worker process if a single render runs longer
# than this many seconds -- raise it if renders on your hardware/models
# routinely run long (the old 1200s default was already too tight for a
# genuine ~20 minute render; see settings.py's Q_CLUSTER comment).
Q_CLUSTER_TIMEOUT=3600
